{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repairlens.example/schemas/part-manifest.json",
  "title": "RepairLens strict cloud manifest",
  "description": "The complete eligible request body. No wrapper or extra metadata is allowed.",
  "type": "array",
  "minItems": 1,
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["part_name", "quantity"],
    "properties": {
      "part_name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 +./()_-]*$"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 99
      }
    }
  }
}
